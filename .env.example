# ------------------------------------------------------------------
# BusinessOS local development environment
# Copy to .env and adjust. Every variable is validated at app startup
# (packages/config) — apps refuse to boot with missing/invalid values.
# ------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Web (Next.js) -------------------------------------------------
# Port is passed to `next dev -p` / `next start -p`.
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Base URL used in emails (invitation / password reset links).
APP_BASE_URL=http://localhost:3000

# --- API (Fastify) -------------------------------------------------
API_PORT=3001
API_HOST=127.0.0.1
# 32+ character random string. Used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef

# --- PostgreSQL ----------------------------------------------------
DATABASE_URL=postgresql://businessos:businessos@localhost:5432/businessos
# Separate database for integration tests (created by infrastructure/postgres/init).
DATABASE_URL_TEST=postgresql://businessos:businessos@localhost:5432/businessos_test

# --- RabbitMQ ------------------------------------------------------
RABBITMQ_URL=amqp://businessos:businessos@localhost:5672

# --- Worker --------------------------------------------------------
WORKER_HEALTH_PORT=3009

# --- SMTP (Mailpit in development) ---------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=BusinessOS <no-reply@businessos.local>

# --- Object storage (MinIO locally; first used in Phase 2) ---------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=businessos
S3_SECRET_KEY=businessos-dev-secret
S3_BUCKET=businessos
S3_REGION=us-east-1
