{
  "name": "@businessos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@businessos/eslint-config": "workspace:*",
    "@businessos/tsconfig": "workspace:*",
    "@businessos/types": "workspace:*",
    "@types/node": "^22.10.5",
    "argon2": "^0.45.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
