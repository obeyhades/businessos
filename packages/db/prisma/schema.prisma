// BusinessOS database schema — Phase 1 (auth, organizations, memberships,
// sessions, invitations, audit, outbox). Later phases append models; existing
// columns are only changed through new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  ACCOUNTANT
  MANAGER
  EMPLOYEE
  READONLY
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  locale          String   @default("en")
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         OrganizationMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     Invitation[]         @relation("InvitationInvitedBy")
  auditLogs           AuditLog[]           @relation("AuditLogActor")

  // Phase 2 back-relations
  createdCustomers    Customer[]       @relation("CustomerCreatedBy")
  createdProjects     Project[]        @relation("ProjectCreatedBy")
  createdTasks        Task[]           @relation("TaskCreatedBy")
  assignedTasks       Task[]           @relation("TaskAssignee")
  comments            Comment[]        @relation("CommentAuthor")
  uploadedAttachments FileAttachment[] @relation("FileAttachmentUploadedBy")
  activities          Activity[]       @relation("ActivityActor")

  // Phase 3 back-relations
  employeeProfile           Employee?          @relation("EmployeeUser")
  authoredEmployeeNotes     EmployeeNote[]     @relation("EmployeeNoteAuthor")
  uploadedEmployeeDocuments EmployeeDocument[] @relation("EmployeeDocumentUploadedBy")
  reviewedAbsences          AbsenceRequest[]   @relation("AbsenceReviewedBy")

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  locale      String   @default("en")
  currency    String   @default("SEK")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members     OrganizationMember[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  // Phase 2 back-relations
  customers        Customer[]
  customerContacts CustomerContact[]
  projects         Project[]
  tasks            Task[]
  comments         Comment[]
  fileAttachments  FileAttachment[]
  activities       Activity[]

  // Phase 3 back-relations
  employees           Employee[]
  employeeNotes       EmployeeNote[]
  certifications      Certification[]
  absenceRequests     AbsenceRequest[]
  employeeDocuments   EmployeeDocument[]
  onboardingTemplates OnboardingTemplate[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Opaque server-side sessions (ADR-0002). Only the SHA-256 hash of the token
// is stored; the raw token exists solely in the HttpOnly cookie.
model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  tokenHash            String   @unique @map("token_hash")
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  lastUsedAt           DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  ip                   String?
  userAgent            String?  @map("user_agent")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only. organizationId is null for events that happen before any
// organization exists (registration, login, password reset).
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}

// Transactional outbox (ADR-0005): written in the same transaction as the
// domain change, relayed to RabbitMQ by the worker, then marked published.
model OutboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox_messages")
}

// Consumer idempotency ledger: a (message, consumer) pair is processed once.
model ProcessedMessage {
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([messageId, consumer])
  @@map("processed_messages")
}

// Jobs that exhausted retries; surfaced in the platform-admin UI.
model FailedJob {
  id          String    @id @default(uuid()) @db.Uuid
  queue       String
  messageType String    @map("message_type")
  payload     Json
  error       String
  attempts    Int
  failedAt    DateTime  @default(now()) @map("failed_at") @db.Timestamptz(6)
  retriedAt   DateTime? @map("retried_at") @db.Timestamptz(6)

  @@index([failedAt(sort: Desc)])
  @@map("failed_jobs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Customers, contacts, projects, tasks, comments, attachments,
// activity timelines. Every table carries organization_id for tenant isolation.
// ---------------------------------------------------------------------------

enum CustomerStatus {
  LEAD
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  orgNumber      String?        @map("org_number")
  email          String?
  phone          String?
  addressLine1   String?        @map("address_line1")
  addressLine2   String?        @map("address_line2")
  postalCode     String?        @map("postal_code")
  city           String?
  country        String?
  notes          String?
  status         CustomerStatus @default(ACTIVE)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts     CustomerContact[]
  projects     Project[]
  tasks        Task[]
  comments     Comment[]
  attachments  FileAttachment[]
  activities   Activity[]

  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("customers")
}

model CustomerContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  title          String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@map("customer_contacts")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        Task[]
  comments     Comment[]
  attachments  FileAttachment[]
  activities   Activity[]

  @@index([organizationId, status])
  @@index([customerId])
  @@map("projects")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @map("due_date") @db.Timestamptz(6)
  customerId     String?      @map("customer_id") @db.Uuid
  projectId      String?      @map("project_id") @db.Uuid
  employeeId     String?      @map("employee_id") @db.Uuid
  assigneeId     String?      @map("assignee_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comments     Comment[]
  attachments  FileAttachment[]
  activities   Activity[]

  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([projectId])
  @@index([customerId])
  @@index([employeeId])
  @@map("tasks")
}

// Polymorphic: attached to exactly one of customer/project/task
// (enforced in the service layer). Cascades away with its parent.
model Comment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  customerId     String?  @map("customer_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, taskId])
  @@map("comments")
}

// Metadata for a file stored in object storage (MinIO/S3). The bytes live under
// storage_key; only signed, short-lived URLs are ever handed to clients.
model FileAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  size           Int
  storageKey     String   @unique @map("storage_key")
  customerId     String?  @map("customer_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("FileAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, taskId])
  @@map("file_attachments")
}

// Append-only user-facing timeline (distinct from the security audit log).
// customer_id is denormalized on every row that resolves to a customer so a
// customer timeline is a single indexed query.
model Activity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  type           String
  customerId     String?  @map("customer_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  employeeId     String?  @map("employee_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@index([organizationId, projectId, createdAt(sort: Desc)])
  @@index([organizationId, taskId, createdAt(sort: Desc)])
  @@index([organizationId, employeeId, createdAt(sort: Desc)])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Phase 3 — Personnel management. Employee records carry two tiers of data:
// directory fields (personnel.read) and sensitive personal fields
// (personnel.read_sensitive). The tier split is enforced in the API's
// serialization layer, never by hiding columns here.
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDING
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum AbsenceType {
  VACATION
  SICK
  PARENTAL
  UNPAID
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeDocumentCategory {
  CONTRACT
  IDENTIFICATION
  CERTIFICATE
  POLICY
  OTHER
}

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
}

model Employee {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  // Optional link to a platform user (an employee need not have a login).
  userId         String? @unique @map("user_id") @db.Uuid
  managerId      String? @map("manager_id") @db.Uuid

  // --- Directory tier (personnel.read) ---
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  workEmail        String?          @map("work_email")
  workPhone        String?          @map("work_phone")
  jobTitle         String?          @map("job_title")
  department       String?
  employmentStatus EmploymentStatus @default(ONBOARDING) @map("employment_status")
  employmentType   EmploymentType   @default(FULL_TIME) @map("employment_type")
  startDate        DateTime?        @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date

  // --- Sensitive tier (personnel.read_sensitive) ---
  personalIdNumber         String?   @map("personal_id_number")
  dateOfBirth              DateTime? @map("date_of_birth") @db.Date
  homeAddress              String?   @map("home_address")
  homePostalCode           String?   @map("home_postal_code")
  homeCity                 String?   @map("home_city")
  personalEmail            String?   @map("personal_email")
  personalPhone            String?   @map("personal_phone")
  emergencyContactName     String?   @map("emergency_contact_name")
  emergencyContactPhone    String?   @map("emergency_contact_phone")
  emergencyContactRelation String?   @map("emergency_contact_relation")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?              @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  manager        Employee?          @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        Employee[]         @relation("EmployeeManager")
  notes          EmployeeNote[]
  certifications Certification[]
  absences       AbsenceRequest[]
  documents      EmployeeDocument[]
  tasks          Task[]
  activities     Activity[]

  @@index([organizationId, employmentStatus])
  @@index([organizationId, lastName])
  @@index([managerId])
  @@map("employees")
}

// Restricted internal notes — read/write require personnel.read_sensitive-level
// access (enforced in the route layer), stricter than directory data.
model EmployeeNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  author       User?        @relation("EmployeeNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, createdAt(sort: Desc)])
  @@map("employee_notes")
}

model Certification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  name           String
  issuer         String?
  issuedDate     DateTime? @map("issued_date") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([employeeId])
  @@map("certifications")
}

model AbsenceRequest {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  type           AbsenceType
  status         AbsenceStatus @default(PENDING)
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  reason         String?
  reviewedById   String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?       @map("review_note")
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("AbsenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
  @@map("absence_requests")
}

// Employee documents live in object storage like other attachments, but
// carry a category and a sensitivity flag; sensitive documents require
// personnel.read_sensitive to list or download.
model EmployeeDocument {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  employeeId     String                   @map("employee_id") @db.Uuid
  uploadedById   String?                  @map("uploaded_by_id") @db.Uuid
  fileName       String                   @map("file_name")
  contentType    String                   @map("content_type")
  size           Int
  storageKey     String                   @unique @map("storage_key")
  category       EmployeeDocumentCategory @default(OTHER)
  isSensitive    Boolean                  @default(false) @map("is_sensitive")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

// Reusable onboarding/offboarding checklist templates. Applying a template to
// an employee generates real Tasks (linked via task.employeeId).
model OnboardingTemplate {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?
  type           ChecklistType @default(ONBOARDING)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        OnboardingTemplateItem[]

  @@index([organizationId, type])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  templateId     String  @map("template_id") @db.Uuid
  title          String
  description    String?
  // Task due date = employee start date (or now) + this many days.
  dueOffsetDays  Int     @default(0) @map("due_offset_days")
  sortOrder      Int     @default(0) @map("sort_order")

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("onboarding_template_items")
}
