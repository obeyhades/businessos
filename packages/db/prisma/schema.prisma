// BusinessOS database schema — Phase 1 (auth, organizations, memberships,
// sessions, invitations, audit, outbox). Later phases append models; existing
// columns are only changed through new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  ACCOUNTANT
  MANAGER
  EMPLOYEE
  READONLY
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  locale          String   @default("en")
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         OrganizationMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     Invitation[]         @relation("InvitationInvitedBy")
  auditLogs           AuditLog[]           @relation("AuditLogActor")

  // Phase 2 back-relations
  createdCustomers    Customer[]       @relation("CustomerCreatedBy")
  createdProjects     Project[]        @relation("ProjectCreatedBy")
  createdTasks        Task[]           @relation("TaskCreatedBy")
  assignedTasks       Task[]           @relation("TaskAssignee")
  comments            Comment[]        @relation("CommentAuthor")
  uploadedAttachments FileAttachment[] @relation("FileAttachmentUploadedBy")
  activities          Activity[]       @relation("ActivityActor")

  // Phase 3 back-relations
  employeeProfile           Employee?          @relation("EmployeeUser")
  authoredEmployeeNotes     EmployeeNote[]     @relation("EmployeeNoteAuthor")
  uploadedEmployeeDocuments EmployeeDocument[] @relation("EmployeeDocumentUploadedBy")
  reviewedAbsences          AbsenceRequest[]   @relation("AbsenceReviewedBy")

  // Phase 4 back-relations
  createdQuotes      Quote[]      @relation("QuoteCreatedBy")
  createdInvoices    Invoice[]    @relation("InvoiceCreatedBy")
  recordedPayments   Payment[]    @relation("PaymentCreatedBy")
  createdCreditNotes CreditNote[] @relation("CreditNoteCreatedBy")

  // Phase 5 back-relations
  createdVouchers            Voucher[]           @relation("VoucherCreatedBy")
  postedVouchers             Voucher[]           @relation("VoucherPostedBy")
  uploadedVoucherAttachments VoucherAttachment[] @relation("VoucherAttachmentUploadedBy")

  // Phase 6 back-relations
  ownedCalendars   Calendar[]      @relation("CalendarOwner")
  organizedEvents  CalendarEvent[] @relation("EventOrganizer")
  eventAttendances EventAttendee[]

  // Phase 7 back-relations
  ownedEmailAccounts    EmailAccount[] @relation("EmailAccountOwner")
  composedEmailMessages EmailMessage[] @relation("EmailMessageCreatedBy")

  // Phase 8 back-relations
  createdRecordings Recording[] @relation("RecordingCreatedBy")

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  locale      String   @default("en")
  currency    String   @default("SEK")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members     OrganizationMember[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  // Phase 2 back-relations
  customers        Customer[]
  customerContacts CustomerContact[]
  projects         Project[]
  tasks            Task[]
  comments         Comment[]
  fileAttachments  FileAttachment[]
  activities       Activity[]

  // Phase 3 back-relations
  employees           Employee[]
  employeeNotes       EmployeeNote[]
  certifications      Certification[]
  absenceRequests     AbsenceRequest[]
  employeeDocuments   EmployeeDocument[]
  onboardingTemplates OnboardingTemplate[]

  // Phase 4 back-relations
  products        Product[]
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  creditNotes     CreditNote[]
  numberSequences NumberSequence[]

  // Phase 5 back-relations
  accounts       Account[]
  fiscalYears    FiscalYear[]
  fiscalPeriods  FiscalPeriod[]
  vouchers       Voucher[]
  accountMapping AccountMapping?

  // Phase 6 back-relations
  calendars      Calendar[]
  calendarEvents CalendarEvent[]

  // Phase 7 back-relations
  emailAccounts EmailAccount[]
  emailThreads  EmailThread[]
  emailMessages EmailMessage[]
  emailLabels   EmailLabel[]

  // Phase 8 back-relations
  recordings Recording[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Opaque server-side sessions (ADR-0002). Only the SHA-256 hash of the token
// is stored; the raw token exists solely in the HttpOnly cookie.
model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  tokenHash            String   @unique @map("token_hash")
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  lastUsedAt           DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  ip                   String?
  userAgent            String?  @map("user_agent")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only. organizationId is null for events that happen before any
// organization exists (registration, login, password reset).
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}

// Transactional outbox (ADR-0005): written in the same transaction as the
// domain change, relayed to RabbitMQ by the worker, then marked published.
model OutboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox_messages")
}

// Consumer idempotency ledger: a (message, consumer) pair is processed once.
model ProcessedMessage {
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([messageId, consumer])
  @@map("processed_messages")
}

// Jobs that exhausted retries; surfaced in the platform-admin UI.
model FailedJob {
  id          String    @id @default(uuid()) @db.Uuid
  queue       String
  messageType String    @map("message_type")
  payload     Json
  error       String
  attempts    Int
  failedAt    DateTime  @default(now()) @map("failed_at") @db.Timestamptz(6)
  retriedAt   DateTime? @map("retried_at") @db.Timestamptz(6)

  @@index([failedAt(sort: Desc)])
  @@map("failed_jobs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Customers, contacts, projects, tasks, comments, attachments,
// activity timelines. Every table carries organization_id for tenant isolation.
// ---------------------------------------------------------------------------

enum CustomerStatus {
  LEAD
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  orgNumber      String?        @map("org_number")
  email          String?
  phone          String?
  addressLine1   String?        @map("address_line1")
  addressLine2   String?        @map("address_line2")
  postalCode     String?        @map("postal_code")
  city           String?
  country        String?
  notes          String?
  status         CustomerStatus @default(ACTIVE)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts     CustomerContact[]
  projects     Project[]
  tasks        Task[]
  comments     Comment[]
  attachments  FileAttachment[]
  activities   Activity[]
  quotes       Quote[]
  invoices     Invoice[]
  events       CalendarEvent[]
  emailThreads EmailThread[]
  recordings   Recording[]

  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("customers")
}

model CustomerContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  title          String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@map("customer_contacts")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        Task[]
  comments     Comment[]
  attachments  FileAttachment[]
  activities   Activity[]
  events       CalendarEvent[]
  emailThreads EmailThread[]
  recordings   Recording[]

  @@index([organizationId, status])
  @@index([customerId])
  @@map("projects")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @map("due_date") @db.Timestamptz(6)
  customerId     String?      @map("customer_id") @db.Uuid
  projectId      String?      @map("project_id") @db.Uuid
  employeeId     String?      @map("employee_id") @db.Uuid
  assigneeId     String?      @map("assignee_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comments     Comment[]
  attachments  FileAttachment[]
  activities   Activity[]
  events       CalendarEvent[]
  emailThreads EmailThread[]
  recordings   Recording[]

  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([projectId])
  @@index([customerId])
  @@index([employeeId])
  @@map("tasks")
}

// Polymorphic: attached to exactly one of customer/project/task
// (enforced in the service layer). Cascades away with its parent.
model Comment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  customerId     String?  @map("customer_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, taskId])
  @@map("comments")
}

// Metadata for a file stored in object storage (MinIO/S3). The bytes live under
// storage_key; only signed, short-lived URLs are ever handed to clients.
model FileAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  size           Int
  storageKey     String   @unique @map("storage_key")
  customerId     String?  @map("customer_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("FileAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, taskId])
  @@map("file_attachments")
}

// Append-only user-facing timeline (distinct from the security audit log).
// customer_id is denormalized on every row that resolves to a customer so a
// customer timeline is a single indexed query.
model Activity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  type           String
  customerId     String?  @map("customer_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  employeeId     String?  @map("employee_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@index([organizationId, projectId, createdAt(sort: Desc)])
  @@index([organizationId, taskId, createdAt(sort: Desc)])
  @@index([organizationId, employeeId, createdAt(sort: Desc)])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Phase 3 — Personnel management. Employee records carry two tiers of data:
// directory fields (personnel.read) and sensitive personal fields
// (personnel.read_sensitive). The tier split is enforced in the API's
// serialization layer, never by hiding columns here.
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDING
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum AbsenceType {
  VACATION
  SICK
  PARENTAL
  UNPAID
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeDocumentCategory {
  CONTRACT
  IDENTIFICATION
  CERTIFICATE
  POLICY
  OTHER
}

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
}

model Employee {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  // Optional link to a platform user (an employee need not have a login).
  userId         String? @unique @map("user_id") @db.Uuid
  managerId      String? @map("manager_id") @db.Uuid

  // --- Directory tier (personnel.read) ---
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  workEmail        String?          @map("work_email")
  workPhone        String?          @map("work_phone")
  jobTitle         String?          @map("job_title")
  department       String?
  employmentStatus EmploymentStatus @default(ONBOARDING) @map("employment_status")
  employmentType   EmploymentType   @default(FULL_TIME) @map("employment_type")
  startDate        DateTime?        @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date

  // --- Sensitive tier (personnel.read_sensitive) ---
  personalIdNumber         String?   @map("personal_id_number")
  dateOfBirth              DateTime? @map("date_of_birth") @db.Date
  homeAddress              String?   @map("home_address")
  homePostalCode           String?   @map("home_postal_code")
  homeCity                 String?   @map("home_city")
  personalEmail            String?   @map("personal_email")
  personalPhone            String?   @map("personal_phone")
  emergencyContactName     String?   @map("emergency_contact_name")
  emergencyContactPhone    String?   @map("emergency_contact_phone")
  emergencyContactRelation String?   @map("emergency_contact_relation")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?              @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  manager        Employee?          @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        Employee[]         @relation("EmployeeManager")
  notes          EmployeeNote[]
  certifications Certification[]
  absences       AbsenceRequest[]
  documents      EmployeeDocument[]
  tasks          Task[]
  activities     Activity[]

  @@index([organizationId, employmentStatus])
  @@index([organizationId, lastName])
  @@index([managerId])
  @@map("employees")
}

// Restricted internal notes — read/write require personnel.read_sensitive-level
// access (enforced in the route layer), stricter than directory data.
model EmployeeNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  author       User?        @relation("EmployeeNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, createdAt(sort: Desc)])
  @@map("employee_notes")
}

model Certification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  name           String
  issuer         String?
  issuedDate     DateTime? @map("issued_date") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([employeeId])
  @@map("certifications")
}

model AbsenceRequest {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  type           AbsenceType
  status         AbsenceStatus @default(PENDING)
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  reason         String?
  reviewedById   String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?       @map("review_note")
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("AbsenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
  @@map("absence_requests")
}

// Employee documents live in object storage like other attachments, but
// carry a category and a sensitivity flag; sensitive documents require
// personnel.read_sensitive to list or download.
model EmployeeDocument {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  employeeId     String                   @map("employee_id") @db.Uuid
  uploadedById   String?                  @map("uploaded_by_id") @db.Uuid
  fileName       String                   @map("file_name")
  contentType    String                   @map("content_type")
  size           Int
  storageKey     String                   @unique @map("storage_key")
  category       EmployeeDocumentCategory @default(OTHER)
  isSensitive    Boolean                  @default(false) @map("is_sensitive")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

// Reusable onboarding/offboarding checklist templates. Applying a template to
// an employee generates real Tasks (linked via task.employeeId).
model OnboardingTemplate {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?
  type           ChecklistType @default(ONBOARDING)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        OnboardingTemplateItem[]

  @@index([organizationId, type])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  templateId     String  @map("template_id") @db.Uuid
  title          String
  description    String?
  // Task due date = employee start date (or now) + this many days.
  dueOffsetDays  Int     @default(0) @map("due_offset_days")
  sortOrder      Int     @default(0) @map("sort_order")

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("onboarding_template_items")
}

// ---------------------------------------------------------------------------
// Phase 4 — Quotes & invoicing. Money is stored as INTEGER MINOR UNITS
// (BigInt, e.g. ore/cents) — never floating point. Quantities and percentages
// are Decimal. Finalized invoices are immutable; corrections use credit notes.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  CREDITED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  SWISH
  OTHER
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
}

enum NumberSequenceKind {
  QUOTE
  INVOICE
  CREDIT_NOTE
  VOUCHER
}

// Per-organization, per-document-type monotonic counter. The `next` value is
// incremented atomically inside the finalize transaction (row lock), which is
// what makes document numbering concurrency-safe.
model NumberSequence {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  kind           NumberSequenceKind
  prefix         String
  padding        Int                @default(4)
  next           Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind])
  @@map("number_sequences")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  sku            String?
  unit           String   @default("piece")
  unitPriceMinor BigInt   @default(0) @map("unit_price_minor")
  currency       String   @default("SEK")
  taxRatePercent Decimal  @default(25) @map("tax_rate_percent") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("products")
}

model Quote {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  customerId         String      @map("customer_id") @db.Uuid
  number             String?
  status             QuoteStatus @default(DRAFT)
  currency           String      @default("SEK")
  issueDate          DateTime    @map("issue_date") @db.Date
  validUntil         DateTime?   @map("valid_until") @db.Date
  customerNotes      String?     @map("customer_notes")
  internalNotes      String?     @map("internal_notes")
  subtotalMinor      BigInt      @default(0) @map("subtotal_minor")
  discountMinor      BigInt      @default(0) @map("discount_minor")
  taxMinor           BigInt      @default(0) @map("tax_minor")
  totalMinor         BigInt      @default(0) @map("total_minor")
  taxLines           Json?       @map("tax_lines")
  acceptedAt         DateTime?   @map("accepted_at") @db.Timestamptz(6)
  declinedAt         DateTime?   @map("declined_at") @db.Timestamptz(6)
  convertedInvoiceId String?     @unique @map("converted_invoice_id") @db.Uuid
  createdById        String?     @map("created_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy        User?           @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  convertedInvoice Invoice?        @relation("QuoteConvertedInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  lineItems        QuoteLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("quotes")
}

model QuoteLineItem {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  quoteId         String  @map("quote_id") @db.Uuid
  productId       String? @map("product_id") @db.Uuid
  description     String
  quantity        Decimal @default(1) @db.Decimal(14, 3)
  unitPriceMinor  BigInt  @default(0) @map("unit_price_minor")
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  lineNetMinor    BigInt  @default(0) @map("line_net_minor")
  lineTaxMinor    BigInt  @default(0) @map("line_tax_minor")
  lineTotalMinor  BigInt  @default(0) @map("line_total_minor")
  sortOrder       Int     @default(0) @map("sort_order")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_line_items")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  number          String?
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("SEK")
  issueDate       DateTime      @map("issue_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  customerNotes   String?       @map("customer_notes")
  internalNotes   String?       @map("internal_notes")
  subtotalMinor   BigInt        @default(0) @map("subtotal_minor")
  discountMinor   BigInt        @default(0) @map("discount_minor")
  taxMinor        BigInt        @default(0) @map("tax_minor")
  totalMinor      BigInt        @default(0) @map("total_minor")
  amountPaidMinor BigInt        @default(0) @map("amount_paid_minor")
  creditedMinor   BigInt        @default(0) @map("credited_minor")
  taxLines        Json?         @map("tax_lines")
  pdfStorageKey   String?       @map("pdf_storage_key")
  finalizedAt     DateTime?     @map("finalized_at") @db.Timestamptz(6)
  sentAt          DateTime?     @map("sent_at") @db.Timestamptz(6)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  lastReminderAt  DateTime?     @map("last_reminder_at") @db.Timestamptz(6)
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  fromQuote    Quote?            @relation("QuoteConvertedInvoice")
  lineItems    InvoiceLineItem[]
  payments     Payment[]
  creditNotes  CreditNote[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  invoiceId       String  @map("invoice_id") @db.Uuid
  productId       String? @map("product_id") @db.Uuid
  description     String
  quantity        Decimal @default(1) @db.Decimal(14, 3)
  unitPriceMinor  BigInt  @default(0) @map("unit_price_minor")
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  lineNetMinor    BigInt  @default(0) @map("line_net_minor")
  lineTaxMinor    BigInt  @default(0) @map("line_tax_minor")
  lineTotalMinor  BigInt  @default(0) @map("line_total_minor")
  sortOrder       Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_line_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  amountMinor    BigInt        @map("amount_minor")
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  paidOn         DateTime      @map("paid_on") @db.Date
  note           String?
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, invoiceId])
  @@map("payments")
}

model CreditNote {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  invoiceId      String           @map("invoice_id") @db.Uuid
  number         String?
  status         CreditNoteStatus @default(DRAFT)
  currency       String           @default("SEK")
  issueDate      DateTime         @map("issue_date") @db.Date
  reason         String?
  subtotalMinor  BigInt           @default(0) @map("subtotal_minor")
  taxMinor       BigInt           @default(0) @map("tax_minor")
  totalMinor     BigInt           @default(0) @map("total_minor")
  taxLines       Json?            @map("tax_lines")
  issuedAt       DateTime?        @map("issued_at") @db.Timestamptz(6)
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems    CreditNoteLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId, invoiceId])
  @@map("credit_notes")
}

model CreditNoteLineItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  creditNoteId   String  @map("credit_note_id") @db.Uuid
  description    String
  quantity       Decimal @default(1) @db.Decimal(14, 3)
  unitPriceMinor BigInt  @default(0) @map("unit_price_minor")
  taxRatePercent Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  lineNetMinor   BigInt  @default(0) @map("line_net_minor")
  lineTaxMinor   BigInt  @default(0) @map("line_tax_minor")
  lineTotalMinor BigInt  @default(0) @map("line_total_minor")
  sortOrder      Int     @default(0) @map("sort_order")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId, sortOrder])
  @@map("credit_note_line_items")
}

// ---------------------------------------------------------------------------
// Phase 5 — Bookkeeping support (double-entry ledger). A voucher (verifikation)
// is a journal entry: a numbered, dated document whose lines must balance
// (sum debit == sum credit) before it can be POSTED. Posted vouchers are
// immutable and corrected only by reversing vouchers. Money is integer minor
// units (BigInt). NOT reviewed for accounting/tax compliance — see
// docs/legal-review-required.md.
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum VoucherStatus {
  DRAFT
  POSTED
  REVERSED
}

enum VoucherSource {
  MANUAL
  INVOICE
  PAYMENT
  OPENING_BALANCE
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  code           String
  name           String
  type           AccountType
  description    String?
  isActive       Boolean     @default(true) @map("is_active")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voucherLines VoucherLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("accounts")
}

model FiscalYear {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      FiscalPeriod[]

  @@unique([organizationId, name])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  fiscalYearId   String             @map("fiscal_year_id") @db.Uuid
  name           String
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  vouchers     Voucher[]

  @@index([organizationId, startDate])
  @@map("fiscal_periods")
}

model Voucher {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  number            String?
  date              DateTime      @db.Date
  description       String
  status            VoucherStatus @default(DRAFT)
  source            VoucherSource @default(MANUAL)
  // Loose reference to the originating document (no FK, so vouchers survive it).
  sourceType        String?       @map("source_type")
  sourceId          String?       @map("source_id") @db.Uuid
  fiscalPeriodId    String?       @map("fiscal_period_id") @db.Uuid
  totalDebitMinor   BigInt        @default(0) @map("total_debit_minor")
  totalCreditMinor  BigInt        @default(0) @map("total_credit_minor")
  reversesVoucherId String?       @unique @map("reverses_voucher_id") @db.Uuid
  reconciledAt      DateTime?     @map("reconciled_at") @db.Timestamptz(6)
  postedAt          DateTime?     @map("posted_at") @db.Timestamptz(6)
  createdById       String?       @map("created_by_id") @db.Uuid
  postedById        String?       @map("posted_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod?       @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("VoucherCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy     User?               @relation("VoucherPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  // Self-relation: a reversal voucher points at the original; the original sees
  // its reversal via `reversedBy`.
  reverses     Voucher?            @relation("VoucherReversal", fields: [reversesVoucherId], references: [id], onDelete: SetNull)
  reversedBy   Voucher?            @relation("VoucherReversal")
  lines        VoucherLine[]
  attachments  VoucherAttachment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@index([sourceType, sourceId])
  @@map("vouchers")
}

model VoucherLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  voucherId      String  @map("voucher_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  description    String?
  // A line is either a debit or a credit; the other side is 0.
  debitMinor     BigInt  @default(0) @map("debit_minor")
  creditMinor    BigInt  @default(0) @map("credit_minor")
  sortOrder      Int     @default(0) @map("sort_order")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([voucherId, sortOrder])
  @@index([organizationId, accountId])
  @@map("voucher_lines")
}

model VoucherAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  voucherId      String   @map("voucher_id") @db.Uuid
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  size           Int
  storageKey     String   @unique @map("storage_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  voucher    Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("VoucherAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, voucherId])
  @@map("voucher_attachments")
}

// Per-organization default accounts used to auto-generate draft vouchers from
// invoices and payments (configurable accounting rules).
model AccountMapping {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @unique @map("organization_id") @db.Uuid
  salesAccountId      String?  @map("sales_account_id") @db.Uuid
  outputVatAccountId  String?  @map("output_vat_account_id") @db.Uuid
  receivableAccountId String?  @map("receivable_account_id") @db.Uuid
  bankAccountId       String?  @map("bank_account_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("account_mappings")
}

// ---------------------------------------------------------------------------
// Phase 6 — Calendar & tasks. Team + personal calendars; events with
// attendees/RSVP, reminders, recurrence, per-occurrence exceptions, and links
// into the business context (customer/project/task). Times are stored as UTC
// instants (Timestamptz); recurrence is expanded server-side per query.
// ---------------------------------------------------------------------------

enum CalendarType {
  TEAM
  PERSONAL
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum EventVisibility {
  DEFAULT
  PRIVATE
}

enum AttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum ReminderMethod {
  EMAIL
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ExceptionType {
  CANCELLED
  OVERRIDE
}

model Calendar {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  color          String       @default("#3b82f6")
  type           CalendarType @default(TEAM)
  ownerId        String?      @map("owner_id") @db.Uuid
  isDefault      Boolean      @default(false) @map("is_default")
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?           @relation("CalendarOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events       CalendarEvent[]

  @@index([organizationId, type])
  @@map("calendars")
}

model CalendarEvent {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  calendarId          String          @map("calendar_id") @db.Uuid
  title               String
  description         String?
  location            String?
  startsAt            DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime        @map("ends_at") @db.Timestamptz(6)
  allDay              Boolean         @default(false) @map("all_day")
  timezone            String          @default("Europe/Stockholm")
  status              EventStatus     @default(CONFIRMED)
  visibility          EventVisibility @default(DEFAULT)
  organizerId         String?         @map("organizer_id") @db.Uuid
  // Business context (denormalized, mirrors the activity ref chain).
  customerId          String?         @map("customer_id") @db.Uuid
  projectId           String?         @map("project_id") @db.Uuid
  taskId              String?         @map("task_id") @db.Uuid
  // Recurrence — null freq means a single (non-recurring) event.
  recurrenceFreq      RecurrenceFreq? @map("recurrence_freq")
  recurrenceInterval  Int             @default(1) @map("recurrence_interval")
  recurrenceByWeekday Int[]           @map("recurrence_by_weekday")
  recurrenceCount     Int?            @map("recurrence_count")
  recurrenceUntil     DateTime?       @map("recurrence_until") @db.Timestamptz(6)
  createdById         String?         @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendar      Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  organizer     User?            @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  attendees     EventAttendee[]
  reminders     EventReminder[]
  exceptions    EventException[]
  sentReminders SentReminder[]

  @@index([organizationId, startsAt])
  @@index([calendarId, startsAt])
  @@index([organizationId, customerId])
  @@map("calendar_events")
}

model EventAttendee {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  response       AttendeeResponse @default(NEEDS_ACTION)
  isOrganizer    Boolean          @default(false) @map("is_organizer")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([organizationId, userId])
  @@map("event_attendees")
}

model EventReminder {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  minutesBefore  Int            @map("minutes_before")
  method         ReminderMethod @default(EMAIL)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_reminders")
}

// A single occurrence of a recurring event that has been cancelled or edited.
// `occurrenceStart` is the ORIGINAL (rule-generated) UTC start it replaces.
model EventException {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  occurrenceStart DateTime      @map("occurrence_start") @db.Timestamptz(6)
  type            ExceptionType
  // Override fields (all null when type = CANCELLED).
  title           String?
  description     String?
  location        String?
  startsAt        DateTime?     @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?     @map("ends_at") @db.Timestamptz(6)
  status          EventStatus?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceStart])
  @@index([organizationId, eventId])
  @@map("event_exceptions")
}

// Worker idempotency ledger: one row per (reminder, occurrence) actually sent,
// so the reminder sweep never double-notifies. The unique constraint is the
// authoritative guard.
model SentReminder {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  reminderId      String   @map("reminder_id") @db.Uuid
  occurrenceStart DateTime @map("occurrence_start") @db.Timestamptz(6)
  sentAt          DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([reminderId, occurrenceStart])
  @@index([organizationId, eventId])
  @@map("sent_reminders")
}

// ---------------------------------------------------------------------------
// Phase 7 — Email. Shared/personal mailboxes, threaded conversations, inbound
// (via a provider webhook seam) and outbound (via the worker email pipeline)
// messages, folders/labels, attachments, and links into the business context
// (customer/project/task). NOT a real IMAP client — inbound arrives through the
// authenticated ingestion endpoint; see docs.
// ---------------------------------------------------------------------------

enum EmailAccountType {
  SHARED
  PERSONAL
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailMessageStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  RECEIVED
}

enum EmailFolder {
  INBOX
  ARCHIVE
  TRASH
}

model EmailAccount {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  address        String
  displayName    String?          @map("display_name")
  type           EmailAccountType @default(SHARED)
  ownerId        String?          @map("owner_id") @db.Uuid
  provider       String           @default("manual")
  isActive       Boolean          @default(true) @map("is_active")
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?          @relation("EmailAccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  threads      EmailThread[]
  messages     EmailMessage[]

  @@unique([organizationId, address])
  @@index([organizationId, type])
  @@map("email_accounts")
}

model EmailThread {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  accountId          String      @map("account_id") @db.Uuid
  subject            String
  snippet            String?
  folder             EmailFolder @default(INBOX)
  isStarred          Boolean     @default(false) @map("is_starred")
  unread             Boolean     @default(false)
  messageCount       Int         @default(0) @map("message_count")
  lastMessageAt      DateTime    @map("last_message_at") @db.Timestamptz(6)
  // Business context (denormalized, mirrors the activity ref chain).
  customerId         String?     @map("customer_id") @db.Uuid
  projectId          String?     @map("project_id") @db.Uuid
  taskId             String?     @map("task_id") @db.Uuid
  // True once a human sets/clears the customer link; auto-link never overrides it.
  customerLinkLocked Boolean     @default(false) @map("customer_link_locked")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      EmailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messages     EmailMessage[]
  labels       EmailThreadLabel[]

  @@index([organizationId, accountId, folder, lastMessageAt])
  @@index([organizationId, customerId])
  @@map("email_threads")
}

model EmailMessage {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  threadId       String             @map("thread_id") @db.Uuid
  accountId      String             @map("account_id") @db.Uuid
  direction      EmailDirection
  status         EmailMessageStatus @default(RECEIVED)
  fromAddress    String             @map("from_address")
  fromName       String?            @map("from_name")
  toAddresses    String[]           @map("to_addresses")
  ccAddresses    String[]           @map("cc_addresses")
  subject        String
  bodyText       String             @map("body_text")
  bodyHtml       String?            @map("body_html")
  // RFC 5322 threading headers.
  messageId      String?            @map("message_id")
  inReplyTo      String?            @map("in_reply_to")
  references     String[]
  isRead         Boolean            @default(false) @map("is_read")
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(6)
  receivedAt     DateTime?          @map("received_at") @db.Timestamptz(6)
  error          String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  account      EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("EmailMessageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attachments  EmailAttachment[]

  @@index([organizationId, threadId, createdAt])
  @@index([organizationId, messageId])
  @@index([organizationId, status])
  @@map("email_messages")
}

model EmailAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  size           Int
  storageKey     String   @unique @map("storage_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, messageId])
  @@map("email_attachments")
}

model EmailLabel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  color          String   @default("#64748b")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  threads      EmailThreadLabel[]

  @@unique([organizationId, name])
  @@map("email_labels")
}

model EmailThreadLabel {
  organizationId String @map("organization_id") @db.Uuid
  threadId       String @map("thread_id") @db.Uuid
  labelId        String @map("label_id") @db.Uuid

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  label  EmailLabel  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([threadId, labelId])
  @@index([labelId])
  @@map("email_thread_labels")
}

// ---------------------------------------------------------------------------
// Phase 8 — Telephony & voice notes. A Recording is a voice note (audio in
// object storage) or a call log (metadata, optionally with audio). Audio is
// transcribed asynchronously by the worker through a pluggable transcriber
// (a deterministic stub locally; a real speech-to-text provider is Phase 9
// behind the same interface). Recordings link into the business context and
// convert to a task or a draft invoice.
// ---------------------------------------------------------------------------

enum RecordingSource {
  VOICE_NOTE
  CALL
}

enum RecordingStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum TranscriptStatus {
  NONE
  PENDING
  COMPLETED
  FAILED
}

model Recording {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  source             RecordingSource  @default(VOICE_NOTE)
  title              String
  // Audio (null for a call log without a recording).
  storageKey         String?          @unique @map("storage_key")
  contentType        String?          @map("content_type")
  durationSeconds    Int?             @map("duration_seconds")
  sizeBytes          Int?             @map("size_bytes")
  status             RecordingStatus  @default(UPLOADED)
  // Call metadata (source = CALL).
  direction          CallDirection?
  fromNumber         String?          @map("from_number")
  toNumber           String?          @map("to_number")
  occurredAt         DateTime         @map("occurred_at") @db.Timestamptz(6)
  // Transcription.
  transcriptStatus   TranscriptStatus @default(NONE) @map("transcript_status")
  transcriptText     String?          @map("transcript_text")
  transcriptLanguage String?          @map("transcript_language")
  transcriptError    String?          @map("transcript_error")
  // Business context (denormalized, mirrors the activity ref chain).
  customerId         String?          @map("customer_id") @db.Uuid
  projectId          String?          @map("project_id") @db.Uuid
  taskId             String?          @map("task_id") @db.Uuid
  createdById        String?          @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("RecordingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  segments     TranscriptSegment[]

  @@index([organizationId, source, occurredAt])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@map("recordings")
}

model TranscriptSegment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  recordingId    String  @map("recording_id") @db.Uuid
  startMs        Int     @map("start_ms")
  endMs          Int     @map("end_ms")
  speaker        String?
  text           String
  sortOrder      Int     @default(0) @map("sort_order")

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  // Unique (not just indexed): a backstop so a concurrent re-transcription of
  // the same recording can never persist duplicate segments — the second
  // writer's transaction fails on this constraint and rolls back.
  @@unique([recordingId, sortOrder])
  @@map("transcript_segments")
}
