{
  "name": "@businessos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@businessos/config": "workspace:*",
    "@businessos/db": "workspace:*",
    "@businessos/storage": "workspace:*",
    "@businessos/types": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.8.1",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.45.0",
    "decimal.js": "^10.4.3",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "pdfkit": "^0.19.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@businessos/eslint-config": "workspace:*",
    "@businessos/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
